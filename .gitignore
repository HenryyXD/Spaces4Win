## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
buildcheck/
[Bb]uild/

# Visual Studio cache/options
.vs/
.vscode/*
!.vscode/extensions.json

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
**/PublishProfiles/*.pubxml.user

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Rider / JetBrains
.idea/
*.sln.iml

# Cursor / local agent scratch
.cursor/

# macOS
.DS_Store

# Test / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*/
*.trx

# Dotnet
*.DotSettings.user
*.AssemblyInfo.cs.bak

# Local runtime / secrets (never commit user machine state)
**/appsettings.*.local.json
**/*.local.json
.env
.env.*
!.env.example

# Spaces4Win local session/config copies accidentally dropped in repo
session-journal.json
config.json
*.tmp
