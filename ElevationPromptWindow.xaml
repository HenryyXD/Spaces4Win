<Window x:Class="Spaces4Win.ElevationPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spaces4Win — Administrator window"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    <StackPanel Margin="16">
        <TextBlock Text="Administrator window detected"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Text="A window (for example Rider running as admin) cannot be hidden or moved while Spaces4Win is not elevated. Windows blocks this for security (UIPI).&#10;&#10;Restart Spaces4Win as administrator to manage those windows, or choose to always elevate / never ask." />

        <StackPanel>
            <Button Content="Restart as administrator now"
                    Height="32"
                    Margin="0,0,0,8"
                    Click="Restart_Click"
                    IsDefault="True" />
            <Button Content="Always run as administrator"
                    Height="32"
                    Margin="0,0,0,8"
                    Click="Always_Click" />
            <Button Content="Never ask (skip admin windows)"
                    Height="32"
                    Margin="0,0,0,8"
                    Click="Never_Click" />
            <Button Content="Not now"
                    Height="32"
                    Click="Cancel_Click"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
