<UserControl x:Class="Spaces4Win.Settings.Controls.MonitorCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Spaces4Win.Settings.Controls">
    <Border Style="{StaticResource SettingsCard}" Width="{Binding CardWidth}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource StatusBadge}"
                        Margin="12,0,0,0">
                    <TextBlock Text="{Binding RoleText}" Style="{StaticResource StatusBadgeText}" />
                </Border>
            </Grid>
            <Border Height="{Binding CardHeight}"
                    Margin="0,14,0,10"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <controls:WorkspaceDotsControl DataContext="{Binding Dots}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
            </Border>
            <Grid>
                <TextBlock Text="{Binding WorkspaceCountText}" Style="{StaticResource SettingsSecondaryText}" />
                <TextBlock Text="{Binding ActiveLabel}" Style="{StaticResource SettingsSecondaryText}" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="{Binding WindowCountText}" Style="{StaticResource SettingsSecondaryText}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding StickyCountText}" Style="{StaticResource SettingsSecondaryText}" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
