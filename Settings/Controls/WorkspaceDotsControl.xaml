<UserControl x:Class="Spaces4Win.Settings.Controls.WorkspaceDotsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="{StaticResource WorkspaceDotSize}"
                        Height="{StaticResource WorkspaceDotSize}"
                        Margin="4,0"
                        CornerRadius="999"
                        Background="{Binding Fill}"
                        BorderBrush="{Binding Stroke}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding NumberText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{Binding TextBrush}" />
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
