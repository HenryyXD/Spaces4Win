<ui:FluentWindow x:Class="Spaces4Win.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Spaces4Win"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding Loc[App.Name]}"
                     Grid.Row="0"
                     ShowMaximize="True" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="228"
                           CompactPaneLength="72"
                           IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                           MenuItemsSource="{Binding MenuItems}"
                           FooterMenuItemsSource="{Binding FooterItems}">
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <Border Grid.Row="2"
                Padding="20,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Visibility="{Binding Session.HasPendingChanges, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock Text="{Binding Loc[Common.PendingChanges]}"
                           VerticalAlignment="Center"
                           Opacity="0.75" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{Binding Loc[Common.Discard]}"
                               Appearance="Secondary"
                               Width="120"
                               Margin="0,0,8,0"
                               Command="{Binding DiscardCommand}" />
                    <ui:Button Content="{Binding Loc[Common.Save]}"
                               Appearance="Primary"
                               Width="120"
                               Command="{Binding SaveCommand}"
                               IsEnabled="{Binding Session.HasPendingChanges}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
