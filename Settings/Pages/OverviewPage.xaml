<Page x:Class="Spaces4Win.Settings.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Spaces4Win.Settings.Controls"
      xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Border Padding="28,20,28,24">
        <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}" HorizontalAlignment="Left">
            <controls:PageHeader DataContext="{Binding}" />

            <TextBlock Text="{Binding Loc[Settings.Overview.Monitors]}" Style="{StaticResource SettingsSectionTitle}" />
            <TextBlock Text="{Binding Loc[Settings.Overview.MonitorsHint]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Session.Monitors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MonitorCardControl Margin="0,0,14,14" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Loc[Settings.Overview.QuickAccess]}" Style="{StaticResource SettingsSectionTitle}" Margin="0,8,0,10" />

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Overview.IndicatorStatus]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Overview.IndicatorStatus.Desc]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowIndicators, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Overview.Language]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Overview.Language.Desc]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="200"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding LanguageOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Overview.StartWithWindows]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Overview.StartWithWindows.Desc]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Page>
