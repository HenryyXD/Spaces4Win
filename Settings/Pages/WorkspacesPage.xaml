<Page x:Class="Spaces4Win.Settings.Pages.WorkspacesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Spaces4Win.Settings.Controls">
    <Border Padding="28,20,28,24">
        <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}">
            <controls:PageHeader DataContext="{Binding}" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Workspaces.HowItWorks]}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Loc[Settings.Workspaces.Hint.Access]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Loc[Settings.Workspaces.Hint.Create]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Loc[Settings.Workspaces.Hint.Sparse]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Session.Monitors}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource SettingsSecondaryText}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource StatusBadge}"
                                            Margin="12,0,0,0">
                                        <TextBlock Text="{Binding RoleText}" Style="{StaticResource StatusBadgeText}" />
                                    </Border>
                                </Grid>
                                <controls:WorkspaceDotsControl DataContext="{Binding Dots}" Margin="0,14,0,10" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ActiveLabel}" Style="{StaticResource SettingsSecondaryText}" />
                                <TextBlock Text="{Binding WindowCountText}" Style="{StaticResource SettingsSecondaryText}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding StickyCountText}" Style="{StaticResource SettingsSecondaryText}" Margin="0,4,0,8" />
                                <ui:Button Content="{Binding DataContext.Loc[Settings.Workspaces.Delete], RelativeSource={RelativeSource AncestorType=Page}}"
                                           Appearance="Secondary"
                                           HorizontalAlignment="Left"
                                           IsEnabled="{Binding CanDelete}"
                                           Command="{Binding DataContext.DeleteActiveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding DeviceName}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Workspaces.Presets.Title]}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Loc[Settings.Workspaces.Presets.Description]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding DisplayNumber, StringFormat=#{0}}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,0,12,0"
                                             MaxLength="40" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsSecondaryText}"
                                               Text="{Binding UpdatedText}"
                                               Margin="0,0,12,0" />
                                    <ui:Button Grid.Column="3"
                                               Content="{Binding DataContext.Loc[Settings.Workspaces.Presets.Clear], RelativeSource={RelativeSource AncestorType=Page}}"
                                               Appearance="Secondary"
                                               Command="{Binding ClearCommand}"
                                               IsEnabled="{Binding HasContent}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Page>
