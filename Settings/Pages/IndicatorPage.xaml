<Page x:Class="Spaces4Win.Settings.Pages.IndicatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Spaces4Win.Settings.Controls">
    <Border Padding="28,20,28,24">
        <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}">
            <controls:PageHeader DataContext="{Binding}" />

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Indicators.Enabled.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Indicators.Enabled.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowIndicators}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Indicators.Opacity.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Indicators.Opacity.Description]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,8" />
                    <Slider Minimum="0.3" Maximum="1.0"
                            IsSnapToTickEnabled="False"
                            IsMoveToPointEnabled="True"
                            Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Indicators.Scale.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Indicators.Scale.Description]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,8" />
                    <Slider Minimum="0.75" Maximum="1.5"
                            IsSnapToTickEnabled="False"
                            IsMoveToPointEnabled="True"
                            Value="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Indicators.Animations.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Indicators.Animations.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Animations}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Indicators.Fullscreen.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Indicators.Fullscreen.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding HideInFullscreen}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Indicators.PinnedMode.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Indicators.PinnedMode.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Right" VerticalAlignment="Center"
                              ItemsSource="{Binding PinnedModeOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedPinnedMode, Mode=TwoWay}" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                <ui:Button Content="{Binding MoveActionLabel}" Appearance="Secondary" Command="{Binding ToggleMoveIndicatorsCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{Binding Loc[Settings.Indicators.ResetPositions]}" Appearance="Secondary" Command="{Binding ResetPositionsCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Loc[Settings.Indicators.MoveHint]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,16" />

            <TextBlock Text="{Binding Loc[Settings.Indicators.Preview]}" Style="{StaticResource SettingsSectionTitle}" />
            <Border Style="{StaticResource SettingsCard}" HorizontalAlignment="Left"
                    Opacity="{Binding PreviewOpacity}">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding PreviewScale}" ScaleY="{Binding PreviewScale}" />
                </Border.LayoutTransform>
                <Border Background="#CC1E1E1E" CornerRadius="14" Padding="8,6" BorderBrush="#55FFFFFF" BorderThickness="1">
                    <controls:WorkspaceDotsControl DataContext="{Binding PreviewDots}" />
                </Border>
            </Border>
        </StackPanel>
    </Border>
</Page>
