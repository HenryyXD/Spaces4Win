<Page x:Class="Spaces4Win.Settings.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Spaces4Win.Settings.Controls">
    <Border Padding="28,20,28,24">
        <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}">
            <controls:PageHeader DataContext="{Binding}" />

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Theme]}" FontWeight="SemiBold" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding ThemeOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Language]}" FontWeight="SemiBold" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding LanguageOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Animations.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Animations.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding MotionOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedMotion, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Transition.Style.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Transition.Style.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding TransitionStyleOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTransitionStyle, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Transition.Speed.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Appearance.Transition.Speed.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding TransitionSpeedOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTransitionSpeed, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Appearance.Accent]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Appearance.Accent.System]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Loc[Settings.Appearance.Preview]}" Style="{StaticResource SettingsSectionTitle}" Margin="0,8,0,10" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[App.Name]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Background="#CC1E1E1E" CornerRadius="14" Padding="8,6" HorizontalAlignment="Left" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Margin="3,0" Background="#224CC2FF" BorderBrush="#88FFFFFF" BorderThickness="1">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="3,0" Background="#4CC2FF">
                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#101014" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Page>
