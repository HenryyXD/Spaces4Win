<Page x:Class="Spaces4Win.Settings.Pages.BehaviorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Spaces4Win.Settings.Controls">
    <Border Padding="28,20,28,24">
        <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}">
            <controls:PageHeader DataContext="{Binding}" />

            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Sticky.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Sticky.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Loc[Settings.Behavior.Switcher.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Behavior.Switcher.Description]}" Style="{StaticResource SettingsSecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding HideInactiveFromSwitcher, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Loc[Settings.Behavior.SingleFullscreen.Title]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[Settings.Behavior.SingleFullscreen.Description]}" Style="{StaticResource SettingsSecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding EnforceSingleFullscreenPerWorkspace, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Overview.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Overview.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Ignored.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Ignored.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Deletion.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Deletion.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Shutdown.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Shutdown.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsRow}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Advanced.Title]}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Loc[Settings.Behavior.Advanced.Description]}" Style="{StaticResource SettingsSecondaryText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Page>
