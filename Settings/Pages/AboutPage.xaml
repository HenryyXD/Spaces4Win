<Page x:Class="Spaces4Win.Settings.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Spaces4Win.Settings.Controls">
    <Border Padding="28,20,28,24">
        <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}">
            <controls:PageHeader DataContext="{Binding}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[App.Name]}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VersionText}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding Loc[Settings.About.License]}" Style="{StaticResource SettingsSecondaryText}" Margin="0,0,0,16" />

                    <ui:Button Content="{Binding Loc[Settings.About.Repository]}" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding OpenRepositoryCommand}" />
                    <ui:Button Content="{Binding Loc[Settings.About.OpenConfig]}" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding OpenConfigCommand}" />
                    <ui:Button Content="{Binding Loc[Settings.About.OpenLogs]}" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding OpenLogsCommand}" />
                    <ui:Button Content="{Binding Loc[Settings.About.CopyDiagnostics]}" Appearance="Secondary" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding CopyDiagnosticsCommand}" />
                    <ui:Button Content="{Binding Loc[Settings.About.CheckUpdates]}" Appearance="Secondary" HorizontalAlignment="Left" IsEnabled="False"
                               ToolTip="{Binding Loc[Common.ComingSoon]}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Page>
